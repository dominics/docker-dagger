#!/bin/bash
# Configure Tailscale Services for the media server stack.
#
# Run on dagger after a deploy or when adding/changing services.
# Idempotent: re-running replaces the in-memory config with what's defined here.
#
# Why imperative instead of `tailscale serve set-config`?
# As of tailscale 1.96.x the declarative JSON format does NOT enable TLS
# termination — `tcp:443` listeners come up as plain HTTP. Only `--https=443`
# (this script's form) flips the listener to "HTTPS: true" so Tailscale
# terminates TLS with the auto-issued Let's Encrypt cert. File a Tailscale
# issue when the declarative format catches up.
#
# Adding a NEW svc:* needs two prereqs before this script will route:
#   1. Declare the service in the tf-config repo (NOT the admin console). Add it
#      to `tailscale/policy/services.tf`, which creates the VIP service object
#      that allocates the 100.x CIDR and the MagicDNS name, and add it to both
#      `autoApprovers.services` and the `grants[].dst` array in
#      `tailscale/policy/policy.hujson`. Then `just apply tailscale/policy`.
#      Both resources share one state, so the object and the policy admitting it
#      land in a single apply. This used to be a manual admin-console step, and
#      nothing enforced it: svc:jellyfin got the policy and the serve config but
#      never the object, so its name resolved to nothing while this host looked
#      entirely healthy.
#   2. Run this script, then `sudo systemctl restart tailscaled`. A serve
#      reset+advertise alone does NOT re-handshake binding to a freshly-created
#      VIP service object; the daemon restart does.

set -euo pipefail

if [[ $EUID -ne 0 ]]; then
  exec sudo -E "$0" "$@"
fi

declare -A SERVICES=(
  [sonarr]=8989
  [radarr]=7878
  [lidarr]=8686
  [prowlarr]=9696
  [sabnzbd]=8081
  [nzbdav]=3000
  [aiostreams]=8084
  [plex]=32400
  [jellyfin]=8096
  [traefik]=8080
  [redlib]=8090
  [ryot]=8000
  [immich]=2283
)

tailscale serve reset

for svc in "${!SERVICES[@]}"; do
  port="${SERVICES[$svc]}"
  echo "Configuring svc:$svc → http://127.0.0.1:$port"
  tailscale serve --service="svc:$svc" --bg --https=443 "http://127.0.0.1:$port" >/dev/null
done

echo
tailscale serve status --json \
  | jq -r '.Services | to_entries[] | "\(.key)\t→ \(.value.Web | to_entries[0].value.Handlers."/".Proxy)\tHTTPS=\(.value.TCP."443".HTTPS)"'
