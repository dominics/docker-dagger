# The one privileged action CI is allowed to cause on this host.
#
# It exists as a unit, rather than as a docker command in the CI wrapper, so the
# deploy account never needs the docker group. That is not a claim to have
# avoided root: talking to the docker socket is root-equivalent however it is
# dressed up, and this unit runs as root. What is bounded is the *command* — a
# fixed ExecStart the deploy account cannot influence, touching only td-server —
# rather than the user it runs as. sudoers grants exactly
# `systemctl start --wait traged-deploy.service`, with no argument to bend.
#
# Installed by traged/install-deploy-account (run from deploy-dagger).
[Unit]
Description=Pull the current TrageD server image and restart it
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/home/media
Environment=CONFIG_DIR=/etc/media-server
Environment=STORAGE_DIR=/media/storage
# The image is private, so the pull needs a credential. Its own config dir
# rather than /root/.docker: scoped to this deploy, and not picked up by
# anything else that happens to run as root. Populated by
# traged/set-registry-token.
Environment=DOCKER_CONFIG=/etc/traged/docker
ExecStart=/usr/local/bin/traged-pull
