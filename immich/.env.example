# Immich configuration for dagger. Copy to `.env` and fill DB_PASSWORD.
# The real `.env` is gitignored (repo-root `.gitignore` matches it at any depth)
# and is chmod 0600 on the host. Docs:
# https://docs.immich.app/install/environment-variables

# Pinned release. Bump deliberately: re-fetch the matching release compose and
# read release notes for breaking DB migrations first. NOT "release"/"latest".
IMMICH_VERSION=v3.1.0

# Originals, thumbnails, encoded video. Big + sequential IO -> mergerfs pool is fine.
UPLOAD_LOCATION=/media/storage/immich/library

# Postgres data dir. MUST be a real local disk (ext4) - never mergerfs/FUSE.
DB_DATA_LOCATION=/home/dominic/immich/pgdata

# NZ home box; system clock is UTC but photos read better in local time. Change freely.
TZ=Pacific/Auckland

# Internal Postgres password (DB is only reachable inside the compose network,
# never exposed). A-Za-z0-9 only, per Immich's constraint. The live value is in
# 1Password; this file only ever carries the placeholder.
DB_PASSWORD=replace-me-A-Za-z0-9-only

# The values below do not need to be changed.
###################################################################################
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
